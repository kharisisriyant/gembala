{
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", {}] },
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^@gembala/shared$": "<rootDir>/../../packages/shared/src/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testTimeout": 30000,
  "testEnvironment": "node"
}
