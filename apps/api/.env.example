DATABASE_URL=postgres://gembala:gembala@localhost:5433/gembala
# Comma-separated kid:secret pairs. Use 32+ random bytes for every secret.
JWT_SIGNING_KEYS=default:change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACTIVE_KID=default
JWT_ISSUER=gembala-api
JWT_AUDIENCE=gembala-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
AUTH_PASSWORD_RATE_LIMIT=5
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional locally: without an API key, emails are logged to the API console.
# In Resend, verify the sender domain before using it in production.
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gembala

# Optional: Telegram bot integration. Leave all four unset to disable the
# feature entirely — the app runs fine without them.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=

# Optional: OpenRouter-backed AI assistant for the Telegram bot. Leave unset
# to disable — linked users get a fixed "not configured yet" reply instead.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Comma-separated existing organization-admin emails allowed to invite new organizations.
PLATFORM_ADMIN_EMAILS=kharisisriyant@gmail.com
