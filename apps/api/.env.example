DATABASE_URL=postgres://gembala:gembala@localhost:5433/gembala
# Comma-separated kid:secret pairs. Use 32+ random bytes for every secret.
JWT_SIGNING_KEYS=default:change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACTIVE_KID=default
JWT_ISSUER=gembala-api
JWT_AUDIENCE=gembala-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
AUTH_PASSWORD_RATE_LIMIT=5
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional locally: without an API key, emails are logged to the API console.
# In Resend, verify the sender domain before using it in production.
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gembala

# Signs unsubscribe/action links in notification emails (32+ chars; required in
# production). API_PUBLIC_URL is the API base mail clients POST one-click
# unsubscribes to. RESEND_WEBHOOK_SECRET verifies delivery/bounce callbacks sent
# to POST /api/webhooks/resend (rejected with 401 while unset).
NOTIFICATION_LINK_SECRET=
API_PUBLIC_URL=http://localhost:3000/api
# RESEND_WEBHOOK_SECRET=whsec_...

# Notification queue. Redis holds queued jobs only; Postgres is the source of
# truth. Prod Redis must run with appendonly yes and maxmemory-policy noeviction.
# Workers run inside the API process when NOTIFICATIONS_WORKERS=true.
REDIS_URL=redis://localhost:6380
NOTIFICATIONS_WORKERS=true

# Optional: Telegram bot integration. Leave all four unset to disable the
# feature entirely — the app runs fine without them.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET= (A-Z a-z 0-9 _ - only; Telegram sends it back in the
#   X-Telegram-Bot-Api-Secret-Token header and the API rejects calls without it)
# TELEGRAM_WEBHOOK_URL=

# Optional: OpenRouter-backed AI assistant for the Telegram bot. Leave unset
# to disable — linked users get a fixed "not configured yet" reply instead.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Comma-separated existing organization-admin emails allowed to invite new organizations.
PLATFORM_ADMIN_EMAILS=kharisisriyant@gmail.com

# Optional: Google sign-in and org-level Google Calendar sync. Set all three or
# none. Create an OAuth "Web application" client in Google Cloud and add these
# redirect URIs (API_PUBLIC_URL + path):
#   <API_PUBLIC_URL>/auth/google/callback
#   <API_PUBLIC_URL>/google-calendar/callback
# Calendar sync also needs the Google Calendar API enabled and the
# calendar.app.created scope on the consent screen.
# GOOGLE_TOKEN_ENCRYPTION_KEY (32+ chars) encrypts stored Google refresh tokens;
# changing it disconnects every connected calendar.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
